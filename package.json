{
  "name": "silverstripe-analytics",
  "description": "A GDPR-complient analytics module integrated into Silverstripe",
  "main": "./client/src/boot/index.js",
  "author": "Jan Metzger <jan.metzger@gmx.net>",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "build": "yarn && NODE_ENV=production webpack --mode production --bail --progress",
    "dev": "NODE_ENV=development webpack --progress",
    "watch": "NODE_ENV=development webpack --watch --progress"
  },
  "dependencies": {
    "apexcharts": "^5",
    "react": "^18.2",
    "react-apexcharts": "^2",
    "react-loading-skeleton": "^3"
  },
  "devDependencies": {
    "@silverstripe/webpack-config": "^3",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.0"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "modules": false
        }
      ],
      "@babel/preset-react"
    ]
  }
